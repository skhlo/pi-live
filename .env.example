# Copy to .env (gitignored) for browser mode in this checkout. Pi Live reads
# only the first five; values in Pi's environment win.
TYPESAFE_API_KEY=
# JEV_API_KEY=
# Offer to start Chrome + third-party voice-browser with the key, until the Pi
# session ends (see Browser sidecar in GLOSSARY.md). A Pi crash leaves it
# running; the next session reuses it without owning it.
# VOICE_BROWSER_DIR=/absolute/path/to/jev-voice-browser
# Optional for an externally managed browser; automatic for Pi's owned sidecar.
# PI_LIVE_BROWSER_CDP=http://127.0.0.1:9333
# PI_LIVE_BROWSER_URL=ws://127.0.0.1:8787
# Another Chrome binary or profile, for the sidecar script and the Codex
# browser server.
# SIDECAR_CHROME=/Applications/Google Chrome Canary.app/Contents/MacOS/Google Chrome Canary
# SIDECAR_CHROME_PROFILE=/absolute/path/to/profile
