# Lets Codex, including Codex voice, hand a request to Pi without an approval
# prompt. The allow decision also runs Pi outside Codex's sandbox, which Pi
# needs to write its session and reach its provider. The command is owned by
# .agents/skills/pi-handoff/SKILL.md; scripts/pi-handoff.test.ts keeps the two
# in step.
prefix_rule(
    pattern = ["pi", "-p", "--session-id", "codex-handoff", "--thinking", "low"],
    decision = "allow",
    justification = "Codex hands this checkout's work to Pi through the pi-handoff skill.",
    match = [
        "pi -p --session-id codex-handoff --thinking low \"What's the branch?\"",
    ],
    not_match = [
        "pi -p \"What's the branch?\"",
        "pi -p --session-id other --thinking low \"What's the branch?\"",
        "pi -p --session-id codex-handoff --thinking high \"What's the branch?\"",
    ],
)
